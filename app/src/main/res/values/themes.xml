<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.OeplNfc" parent="Theme.MaterialComponents.DayNight.DarkActionBar" />

    <!--
        A section header and its body. The header carries the open/closed
        marker, which MainActivity sets, and is the whole touch target - the
        text is the control, so there is no separate chevron to miss.
    -->
    <style name="SectionHead">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">6dp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">15sp</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:background">?android:attr/selectableItemBackground</item>
    </style>

    <style name="SectionBody">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">vertical</item>
    </style>
</resources>
